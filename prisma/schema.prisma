generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institute {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
  batches   Batch[]
  students  Student[]
  subjects  Subject[]
  tests     Test[]
}

model Subject {
  id          String     @id @default(cuid())
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  name        String?    @default("")
  instituteId String?
  institute   Institute? @relation(fields: [instituteId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "subject_institute_fkey")
  tests       Test[]
}

model Batch {
  id          String     @id @default(cuid())
  name        String
  instituteId String?
  createdAt   DateTime?  @default(now()) @db.Timestamptz(6)
  institute   Institute? @relation(fields: [instituteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  students    Student[]
}

model Student {
  id          String     @id @default(cuid())
  name        String
  email       String?
  instituteId String?
  batchId     String?
  attempts    Attempt[]
  batch       Batch?     @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  institute   Institute? @relation(fields: [instituteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Test {
  id          String    @id @default(cuid())
  title       String
  instituteId String?
  createdAt   DateTime? @default(now()) @db.Timestamptz(6)
  subjectId   String?

  positiveMarks Float @default(1)
  negativeMarks Float @default(0)

  durationHours   Int @default(0)
  durationMinutes Int @default(0)
  durationSeconds Int @default(0)

  attempts  Attempt[]
  questions Question[]

  institute Institute? @relation(fields: [instituteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subject   Subject?   @relation(fields: [subjectId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "test_subject_fkey")
}

model Question {
  id          String   @id @default(cuid())
  text        String
  testId      String?
  marks       Int?     @default(1)
  explanation String?
  Answer      Answer[]
  options     Option[]
  test        Test?    @relation(fields: [testId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Option {
  id         String    @id @default(cuid())
  text       String
  isCorrect  Boolean?  @default(false)
  questionId String?
  Answer     Answer[]
  question   Question? @relation(fields: [questionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Attempt {
  id        String  @id @default(cuid())
  studentId String?
  testId    String?
  score     Float?  @default(0)

  correctAnswers Int   @default(0)
  wrongAnswers   Int   @default(0)
  skippedAnswers Int   @default(0)
  timeTaken      Int   @default(0)
  percentage     Float @default(0)

  rank Int?

  createdAt DateTime? @default(now()) @db.Timestamptz(6)

  Answer  Answer[]
  student Student? @relation(fields: [studentId], references: [id])
  test    Test?    @relation(fields: [testId], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Answer {
  id         String    @id
  attemptId  String?
  questionId String?
  optionId   String?
  isCorrect  Boolean?  @default(false)
  Attempt    Attempt?  @relation(fields: [attemptId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Option     Option?   @relation(fields: [optionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Question   Question? @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
